# Server
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
APP_BASE_URL=https://shapop.app
PLATFORM_COMMISSION=0.08
AI_MODEL=claude-sonnet-4-5-20250929

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_service_key

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PayPal
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# LiveKit (WebRTC streaming)
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud
# 0 = no participant cap enforced by LiveKit
LIVEKIT_MAX_PARTICIPANTS=0

# Live recordings (S3-compatible: Cloudflare R2). Leave empty = recording disabled.
RECORDING_S3_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
RECORDING_S3_BUCKET=shapop-recordings
RECORDING_S3_REGION=auto
RECORDING_S3_ACCESS_KEY=your_r2_access_key_id
RECORDING_S3_SECRET=your_r2_secret_access_key
RECORDING_PUBLIC_BASE_URL=https://media.shapop.app

# Resend (transactional emails)
RESEND_API_KEY=re_xxx

# Anthropic (AI features)
ANTHROPIC_API_KEY=sk-ant-xxx

# Replicate (image generation)
REPLICATE_API_KEY=r8_xxx

# Apple Push Notifications (APNs)
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_apns_team_id
APNS_BUNDLE_ID=com.shapop.app
APNS_KEY_PATH=path/to/AuthKey.p8
APNS_PRIVATE_KEY=your_apns_private_key_contents
APNS_PRODUCTION=false

# Twilio (SMS verification)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Sentry (error monitoring)
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Admin
ADMIN_EMAILS=admin@example.com
