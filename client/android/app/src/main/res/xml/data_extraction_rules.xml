<?xml version="1.0" encoding="utf-8"?>
<!-- Pas de sauvegarde cloud ni de transfert d'appareil des données de l'app
     (session de connexion, préférences) : on se reconnecte sur un nouveau téléphone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
