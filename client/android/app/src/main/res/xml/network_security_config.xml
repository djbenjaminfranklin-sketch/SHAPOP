<?xml version="1.0" encoding="utf-8"?>
<!-- Aucun trafic HTTP en clair : tout passe en HTTPS (Supabase, Render, Stripe, LiveKit en wss). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
