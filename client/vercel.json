{
  "buildCommand": "vite build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/((?!api|assets|sw\\.js|workbox-|manifest\\.webmanifest|sitemap\\.xml|robots\\.txt|og-image\\.png|logo\\.png|pwa-|apple-touch-).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
